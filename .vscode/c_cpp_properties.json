{
    "version": 4,
    "configurations": [
        {
            "name": "Arduino",
            "compilerPath": "${env:HOME}/.arduino15/packages/esp32/tools/esp-x32/2601/bin/xtensa-esp32-elf-g++",
            "intelliSenseMode": "gcc-x64",
            "cStandard": "gnu17",
            "cppStandard": "gnu++23",
            "includePath": [
                "${workspaceFolder}",
                "${env:HOME}/.arduino15/packages/esp32/tools/esp32-libs/3.3.11/qio_qspi/include",
                "${env:HOME}/.arduino15/packages/esp32/hardware/esp32/3.3.11/cores/esp32",
                "${env:HOME}/.arduino15/packages/esp32/hardware/esp32/3.3.11/variants/esp32da",
                "${env:HOME}/.arduino15/packages/esp32/hardware/esp32/3.3.11/libraries/WiFi/src",
                "${env:HOME}/.arduino15/packages/esp32/hardware/esp32/3.3.11/libraries/Network/src",
                "${env:HOME}/.arduino15/packages/esp32/hardware/esp32/3.3.11/libraries/NetworkClientSecure/src",
                "${env:HOME}/.arduino15/packages/esp32/hardware/esp32/3.3.11/libraries/FS/src",
                "${env:HOME}/.arduino15/packages/esp32/hardware/esp32/3.3.11/libraries/LittleFS/src",
                "${env:HOME}/.arduino15/packages/esp32/hardware/esp32/3.3.11/libraries/WebServer/src",
                "${env:HOME}/.arduino15/packages/esp32/hardware/esp32/3.3.11/libraries/DNSServer/src",
                "${env:HOME}/.arduino15/packages/esp32/hardware/esp32/3.3.11/libraries/AsyncUDP/src",
                "${env:HOME}/.arduino15/packages/esp32/hardware/esp32/3.3.11/libraries/Preferences/src",
                "${env:HOME}/.arduino15/packages/esp32/hardware/esp32/3.3.11/libraries/Hash/src",
                "${env:HOME}/Arduino/libraries/ESP_Async_WebServer/src",
                "${env:HOME}/Arduino/libraries/Async_TCP/src",
                "${env:HOME}/Arduino/libraries/ArduinoJson/src",
                "${env:HOME}/Arduino/libraries/UniversalTelegramBot/src",
                "${env:HOME}/Arduino/libraries/PubSubClient/src"
            ],
            "forcedInclude": [
                "${env:HOME}/.arduino15/packages/esp32/hardware/esp32/3.3.11/cores/esp32/Arduino.h"
            ],
            "defines": [
                "F_CPU=240000000L",
                "ARDUINO=10607",
                "ARDUINO_ESP32_WROOM_DA",
                "ARDUINO_ARCH_ESP32",
                "ARDUINO_BOARD=\"ESP32_WROOM_DA\"",
                "ARDUINO_VARIANT=\"esp32da\"",
                "ARDUINO_PARTITION_huge_app",
                "ARDUINO_HOST_OS=\"linux\"",
                "ESP32=ESP32",
                "CORE_DEBUG_LEVEL=0",
                "ARDUINO_RUNNING_CORE=1",
                "ARDUINO_EVENT_RUNNING_CORE=1",
                "ARDUINO_USB_CDC_ON_BOOT=0"
            ]
        }
    ]
}
